<div class="port_section" id="contact_page">
    <div class="title_container"> 
        <h1>CONTACT ME</h1>
    </div>
    <div id="contact_container">
        <form id="contact_form" action="/send-message" method="POST" class="square_info_box wow animate__animated animate__fadeInLeft" data-wow-delay="0.3s" data-wow-duration="0.7s">

            <h3>Send me a message directly</h3>
            <div class="contact_form_item">
                <div class="contact_form_label">
                    <i class="fa-solid fa-user"></i>
                    <span>Name</span>
                </div>
                <input type="text" name="name">
            </div>
            <div class="contact_form_item">
                <div class="contact_form_label">
                    <i class="fa-solid fa-envelope"></i>
                    <span>Email</span>
                </div>
                <input type="email" name="email">
            </div>
            <div class="contact_form_item">
                <div class="contact_form_label">
                    <i class="fa-solid fa-message"></i>
                    <span>Message</span>
                </div>
                <textarea name="message" maxlength="1000"></textarea>
            </div>
            <div id="submit_message" class="contact_form_item">
                <button type="submit" class="rectangle_button">
                    <i class="fa-solid fa-paper-plane"></i>
                    <p>Send</p>
                </button>
            </div>
        
        </form>
        <div id="contact_info" >
            <div class="left_border"></div>
            <div id="contact_info_header" >
                <i class="fa-solid fa-circle-info"></i>
                <span>My info</span>
            </div>
            <div class=" contact_info_item wow animate__animated animate__fadeInUp" data-wow-delay="0.8s" data-wow-duration="0.7s">
                <i class="fa-solid fa-phone"></i>
                <span>+34 601048053</span>
            </div>
            <div class="contact_info_item wow animate__animated animate__fadeInUp" data-wow-delay="1s" data-wow-duration="0.7s">
                <i class="fa-solid fa-envelope"></i>
                <span>davidvillaplana23@gmail.com</span>
            </div>
            <div id="contact_info_buttons">
                <div class="square_button wow animate__animated animate__bounceIn" data-wow-delay="1.5s" data-wow-duration="0.5s">
                    <div class="rotating_border">
                        <a class="inner_box" target="_blank" rel="noopener noreferrer" href="https://github.com/Dvil23">
                            <i class="fa-brands fa-github"></i>
                        </a>
                    </div>
                </div>
                <div class="square_button square_button_right wow animate__animated animate__bounceIn" data-wow-delay="1.6s" data-wow-duration="0.5s">
                    <div class="rotating_border">
                        <a class="inner_box" target="_blank" rel="noopener noreferrer" href="https://www.linkedin.com/in/david-villaplana-gonzalez-382694302/">
                            <i class="fa-brands fa-linkedin-in"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const RECAPTCHA_SITE_KEY = "<%= process.env.RECAPTCHA_SITE_KEY %>"
</script>